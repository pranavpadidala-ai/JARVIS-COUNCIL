<Window x:Class="Council.Desktop.DevelopmentTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JARVIS — Development Tasks" Height="720" Width="1040"
        MinHeight="600" MinWidth="820" Background="#06111D"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="DEVELOPMENT TASK QUEUE" Foreground="#39DDF4" FontSize="21" FontWeight="Light"/>
      <TextBlock Text="Create, review and explicitly approve autonomous coding tasks" Foreground="#8BAEBD" FontSize="11" Margin="0,5,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#0C2030" BorderBrush="#17445A" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,12">
      <TextBlock Text="Creating a task does not run it. APPROVE FOR BACKGROUND grants one run to the local worker; RUN NOW opens JARVIS chat for an explicit foreground run. Every run requires a clean Git tree, checkpoint and successful build/tests before commit." Foreground="#B8D2DE" FontSize="11" TextWrapping="Wrap"/>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*"/>
        <ColumnDefinition Width="1.5*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#091725" BorderBrush="#17445A" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,10,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="SAVED TASKS" Foreground="#39DDF4" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="TaskCount" Text="0 tasks" Foreground="#8BAEBD" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ListBox x:Name="TasksList" Background="Transparent" BorderThickness="0"
                   Foreground="#D7F1FA" SelectionChanged="TasksList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#1A4055" BorderThickness="0,0,0,1" Padding="7">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="#D7F1FA" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Status}" Foreground="#48CBE0" FontSize="10" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding CurrentStep}" Foreground="#7897A8" FontSize="9" TextWrapping="Wrap" MaxHeight="36"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="#091725" BorderBrush="#17445A" BorderThickness="1" CornerRadius="8" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="SELECTED TASK" Foreground="#39DDF4" FontSize="10" FontWeight="Bold"/>
            <TextBlock x:Name="SelectedTitle" Text="Select a task or create a new one." Foreground="#D7F1FA" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,12"/>
            <TextBlock Text="STATUS &amp; APPROVAL" Foreground="#39DDF4" FontSize="10" FontWeight="Bold"/>
            <TextBlock x:Name="SelectedStatus" Text="—" Foreground="#B8D2DE" FontSize="12" Margin="0,6,0,12"/>
            <TextBlock Text="DESCRIPTION" Foreground="#39DDF4" FontSize="10" FontWeight="Bold"/>
            <TextBlock x:Name="SelectedDescription" Text="—" Foreground="#B8D2DE" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12"/>
            <TextBlock Text="CURRENT STEP" Foreground="#39DDF4" FontSize="10" FontWeight="Bold"/>
            <TextBlock x:Name="SelectedStep" Text="—" Foreground="#B8D2DE" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,16"/>

            <Border BorderBrush="#17445A" BorderThickness="0,1,0,0" Padding="0,12,0,0">
              <StackPanel>
                <TextBlock Text="CREATE A TASK" Foreground="#39DDF4" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox x:Name="NewTaskTitle" Padding="9" FontSize="12" Background="#0D2233" Foreground="#E0F7FF" BorderBrush="#1A526B" ToolTip="Short task title"/>
                <TextBox x:Name="NewTaskDescription" Padding="9" FontSize="12" Background="#0D2233" Foreground="#E0F7FF" BorderBrush="#1A526B" Margin="0,7,0,8" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Describe the desired changes and acceptance criteria"/>
                <Button x:Name="CreateButton" Content="CREATE TASK (NOT RUN)" Click="Create_Click" Padding="12,8" HorizontalAlignment="Left" Background="#123447" Foreground="#BDEFFF" BorderBrush="#24718A"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Foreground="#91AEBB" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="REFRESH" Click="Refresh_Click" Padding="13,8" Margin="0,0,8,0" Background="#123447" Foreground="#BDEFFF" BorderBrush="#24718A"/>
        <Button x:Name="RevokeButton" Content="REVOKE APPROVAL" Click="Revoke_Click" IsEnabled="False" Padding="13,8" Margin="0,0,8,0" Background="#38232B" Foreground="#FFD4D8" BorderBrush="#A64B5A"/>
        <Button x:Name="ApproveButton" Content="APPROVE FOR BACKGROUND" Click="Approve_Click" IsEnabled="False" Padding="13,8" Margin="0,0,8,0" Background="#123F3B" Foreground="#C9FFF0" BorderBrush="#287B69"/>
        <Button x:Name="RunButton" Content="OPEN RUN REQUEST IN CHAT" Click="RunNow_Click" IsEnabled="False" Padding="14,8" Background="#10506A" Foreground="White" BorderBrush="#2AC6E0"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>