<Window x:Class="Council.Desktop.PhoneInboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JARVIS — Phone Inbox" Height="620" Width="820"
        MinHeight="480" MinWidth="640" Background="#06111D"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="PHONE INBOX" Foreground="#39DDF4" FontSize="21" FontWeight="Light"/>
      <TextBlock x:Name="BridgeStatus" Foreground="#8BAEBD" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#0C2030" BorderBrush="#17445A" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10">
      <TextBlock Text="Phone requests are queued only. Nothing runs until you select a request and explicitly press APPROVE on this laptop." Foreground="#B8D2DE" FontSize="12" TextWrapping="Wrap"/>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="3*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#091725" BorderBrush="#17445A" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,8,0">
        <ListBox x:Name="CommandsList" Background="Transparent" BorderThickness="0"
                 Foreground="#D7F1FA" SelectionChanged="CommandsList_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#1A4055" BorderThickness="0,0,0,1" Padding="6">
                <StackPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#D7F1FA" FontSize="12" MaxHeight="54"/>
                  <TextBlock Text="{Binding Status}" Foreground="#48CBE0" FontSize="10" Margin="0,5,0,0"/>
                  <TextBlock Text="{Binding CreatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" Foreground="#7897A8" FontSize="9"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Background="#091725" BorderBrush="#17445A" BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel>
          <TextBlock Text="REQUEST" Foreground="#39DDF4" FontSize="10" FontWeight="Bold"/>
          <TextBlock x:Name="CommandText" Text="Select a phone request to review it." Foreground="#D7F1FA" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,16"/>
          <TextBlock Text="STATUS" Foreground="#39DDF4" FontSize="10" FontWeight="Bold"/>
          <TextBlock x:Name="CommandStatus" Text="—" Foreground="#B8D2DE" FontSize="12" Margin="0,6,0,16"/>
          <TextBlock Text="JARVIS RESPONSE" Foreground="#39DDF4" FontSize="10" FontWeight="Bold"/>
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="CommandResult" Text="No response yet." Foreground="#B8D2DE" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#91AEBB" FontSize="11" Margin="0,10,0,8" TextWrapping="Wrap"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="REFRESH" Click="Refresh_Click" Padding="14,8" Margin="0,0,8,0"
              Background="#123447" Foreground="#BDEFFF" BorderBrush="#24718A"/>
      <Button x:Name="RejectButton" Content="REJECT" Click="Reject_Click" IsEnabled="False" Padding="14,8" Margin="0,0,8,0"
              Background="#38232B" Foreground="#FFD4D8" BorderBrush="#A64B5A"/>
      <Button x:Name="ApproveButton" Content="APPROVE & RUN" Click="Approve_Click" IsEnabled="False" Padding="16,8"
              Background="#10506A" Foreground="White" BorderBrush="#2AC6E0"/>
    </StackPanel>
  </Grid>
</Window>